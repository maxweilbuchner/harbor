+static ULONG WINAPI target_Release(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    ULONG ref = InterlockedDecrement(&target->ref);
+
+    if (!ref)
+    {
+        EnterCriticalSection(&dcomp_cs);
+        list_remove(&target->entry);
+        target_show(target, NULL);
+        LeaveCriticalSection(&dcomp_cs);
+        if (target->root) IDCompositionVisual_Release(&target->root->IDCompositionVisual_iface);
+        IDCompositionDevice_Release(&target->device->IDCompositionDevice_iface);
+        free(target);
+    }
+    return ref;
+}
