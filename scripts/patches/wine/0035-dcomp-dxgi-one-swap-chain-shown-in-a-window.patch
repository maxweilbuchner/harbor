+static HRESULT WINAPI target_SetRoot(IDCompositionTarget *iface, IDCompositionVisual *visual)
+{
+    struct composition_target *target = impl_from_IDCompositionTarget(iface);
+    struct composition_visual *old;
 
+    TRACE("iface %p, visual %p.\n", iface, visual);
+
+    if (visual && visual->lpVtbl != &visual_vtbl) return E_INVALIDARG;
+
+    /* It takes effect with the next Commit(). */
+    if (visual) IDCompositionVisual_AddRef(visual);
+    EnterCriticalSection(&dcomp_cs);
+    old = target->root;
+    target->root = visual ? impl_from_IDCompositionVisual(visual) : NULL;
+    LeaveCriticalSection(&dcomp_cs);
+    if (old) IDCompositionVisual_Release(&old->IDCompositionVisual_iface);
+    return S_OK;
+}
