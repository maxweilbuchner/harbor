+/* Makes the swap chain (or none) the one that presents to the target's window. Called with dcomp_cs held. */
+static void target_show(struct composition_target *target, IDXGISwapChain *swapchain)
+{
+    if (target->shown == swapchain) return;
+    if (target->shown)
+    {
+        IDXGISwapChain_SetPrivateData(target->shown, &WINE_DXGI_COMPOSITION_TARGET, 0, NULL);
+        IDXGISwapChain_Release(target->shown);
+    }
+    if ((target->shown = swapchain))
+    {
+        IDXGISwapChain_AddRef(swapchain);
+        if (FAILED(IDXGISwapChain_SetPrivateData(swapchain, &WINE_DXGI_COMPOSITION_TARGET, sizeof(target->hwnd), &target->hwnd)))
+            FIXME("Swap chain %p wasn't made for composition, it stays in its own window.\n", swapchain);
+    }
+}
