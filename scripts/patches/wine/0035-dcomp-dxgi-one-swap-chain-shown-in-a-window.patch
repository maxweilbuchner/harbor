+
+static HRESULT WINAPI device_Commit(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&dcomp_cs);
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct composition_target, entry)
+    {
+        IDXGISwapChain *swapchain = NULL;
+
+        if (target->root && target->root->content
+                && FAILED(IUnknown_QueryInterface(target->root->content, &IID_IDXGISwapChain, (void **)&swapchain)))
+            FIXME("Content %p isn't a swap chain, nothing is shown for it.\n", target->root->content);
+        target_show(target, swapchain);
+        if (swapchain) IDXGISwapChain_Release(swapchain);
+    }
+    LeaveCriticalSection(&dcomp_cs);
+    return S_OK;
+}
