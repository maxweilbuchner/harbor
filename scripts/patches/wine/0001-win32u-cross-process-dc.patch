+/* HARBOR HACK - START: drawing into a window that belongs to another process.
+ *
+ * Chromium's GPU process presents software-composited frames with GetDC( browser_hwnd ) + BitBlt.
+ * A DC for another process's window has no window surface, and the Mac driver cannot draw without
+ * one, so everything drawn was dropped (Steam's client UI stayed black). Give such DCs one of the
+ * shm surfaces of CX HACK 23950: it is flushed by asking the owning window to draw the bits. */
+
+static pthread_mutex_t cross_surfaces_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct window_surface *cross_surfaces[8];
+
+static struct window_surface *get_cross_process_surface( HWND hwnd, const RECT *rect )
+{
+    static unsigned int next_slot;
+    struct window_surface *surface, *old = NULL;
+    unsigned int i, slot;
+
+    pthread_mutex_lock( &cross_surfaces_lock );
+    for (i = 0; i < ARRAY_SIZE(cross_surfaces); i++)
+        if (cross_surfaces[i] && cross_surfaces[i]->hwnd == hwnd) break;
+    if (i < ARRAY_SIZE(cross_surfaces)) old = cross_surfaces[(slot = i)];
+    else slot = next_slot++ % ARRAY_SIZE(cross_surfaces);
+
+    surface = create_shm_surface( hwnd, hwnd, rect, old );
+    if (surface != cross_surfaces[slot])
+    {
+        if (cross_surfaces[slot]) window_surface_release( cross_surfaces[slot] );
+        if ((cross_surfaces[slot] = surface)) window_surface_add_ref( surface );
+    }
+    pthread_mutex_unlock( &cross_surfaces_lock );
+    return surface;
+}
+
+static struct window_surface *find_cross_process_surface( HWND hwnd )
+{
+    struct window_surface *surface = NULL;
+    unsigned int i;
+
+    pthread_mutex_lock( &cross_surfaces_lock );
+    for (i = 0; i < ARRAY_SIZE(cross_surfaces); i++)
+    {
+        if (!cross_surfaces[i] || cross_surfaces[i]->hwnd != hwnd) continue;
+        window_surface_add_ref( (surface = cross_surfaces[i]) );
+        break;
+    }
+    pthread_mutex_unlock( &cross_surfaces_lock );
+    return surface;
+}
 
+/* HARBOR HACK - END */
 
+
