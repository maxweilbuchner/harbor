+    /* HARBOR HACK - START: a fullscreen program gets its Desktop back.
+     *
+     * A fullscreen Wine window is raised above everything only while its process is the active app. Swiping to
+     * another Desktop deactivates the process and drops the window back into the normal stack, usually behind the
+     * window of whatever started it; on the way back macOS then activates that other app instead (the game stayed
+     * hidden behind Steam, Harbor or a terminal). If the process lost activation because the Desktop was switched
+     * away from its fullscreen window, it takes activation back when that Desktop returns, as an app with a
+     * fullscreen Space of its own would. Leaving by clicking another app is not undone. */
+    static BOOL fullscreenLeftBySpaceSwitch;
+    static NSTimeInterval lastResignTime;
+
+    - (WineWindow*) visibleFullscreenWindow
+    {
+        for (NSWindow* w in [NSApp windows])
+        {
+            if ([w isKindOfClass:[WineWindow class]] && ((WineWindow*)w).fullscreen && [w isVisible])
+                return (WineWindow*)w;
         }
+        return nil;
     }
 
+    - (void) reclaimFullscreenDesktop
+    {
+        WineWindow* window = [self visibleFullscreenWindow];
+        if (!window)
+        {
+            fullscreenLeftBySpaceSwitch = FALSE;
+            return;
+        }
+        if (![window isOnActiveSpace])
+        {
+            if ([NSApp isActive] || [NSDate timeIntervalSinceReferenceDate] - lastResignTime < 2.0)
+                fullscreenLeftBySpaceSwitch = TRUE;
+        }
+        else if (fullscreenLeftBySpaceSwitch)
+        {
+            fullscreenLeftBySpaceSwitch = FALSE;
+            if (![NSApp isActive])
+                [self tryToActivateIgnoringOtherApps:YES];
+        }
+    }
+    /* HARBOR HACK - END */
+
     - (void) activeSpaceDidChange
     {
         [self updateFullscreenWindows];
         [self adjustWindowLevels];
+        [self reclaimFullscreenDesktop]; /* HARBOR HACK */
     }
 
     - (void) sendDisplaysChanged:(BOOL)activating
