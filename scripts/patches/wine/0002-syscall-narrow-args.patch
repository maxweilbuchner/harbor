diff -u a/include/wine/unixlib.h b/include/wine/unixlib.h
--- a/include/wine/unixlib.h	2026-11-19 18:14:35
+++ b/include/wine/unixlib.h	2026-11-19 18:14:35
@@ -31,6 +31,14 @@
 
 #ifdef WINE_UNIX_LIB
 
+/* HARBOR HACK: syscall arguments narrower than int (BOOLEAN, WORD, WCHAR...).
+ * The PE caller follows the Win64 ABI, which leaves the upper bits of the argument slot undefined
+ * (clang >= 23 stores just the byte), while the Unix-side function is a SysV function for which
+ * the compiler assumes the caller extended the value to 32 bits. Reload the argument through
+ * memory so that only its own bits are used. Use as a declaration at the top of the function. */
+#define SYSCALL_NARROW_ARG(arg) \
+    __typeof__(arg) arg##_narrow __attribute__((unused)) = ((arg) = *(volatile __typeof__(arg) *)&(arg))
+
 typedef NTSTATUS (*unixlib_entry_t)( void *args );
 
 extern DECLSPEC_EXPORT const unixlib_entry_t __wine_unix_call_funcs[];
