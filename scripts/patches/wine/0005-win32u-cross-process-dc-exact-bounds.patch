     params.hwnd = HandleToLong( surface->header.hwnd );
     params.info = surface->info;
     params.bounds = *dirty;
+
+    /* HARBOR HACK: a surface for drawing into another process's window (parent == hwnd, see
+     * get_cross_process_surface) only holds what was drawn through it, the rest is its initial white.
+     * window_surface_flush() widens the dirty rect to multiples of 8 pixels, which would paint up to
