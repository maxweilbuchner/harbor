+    if (surface->parent == surface->header.hwnd &&
+        !intersect_rect( &params.bounds, &window_surface->bounds, &window_surface->rect ))
+        return TRUE;
 
     return send_message_timeout( surface->parent, WM_WINE_FLUSHSHMSURFACE, 0, (LPARAM)&params,
