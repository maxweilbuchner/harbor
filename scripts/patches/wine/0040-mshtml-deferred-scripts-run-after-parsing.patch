+     * in document order (run_end_load()), not where the parser meets it: such scripts expect the elements
+     * that follow them to exist. */
+    if(window->base.outer_window && window->base.outer_window->readystate == READYSTATE_LOADING
+       && is_deferred_script(script_elem)) {
+        script_queue_entry_t *entry = malloc(sizeof(*entry));
+
+        if(entry) {
+            TRACE("deferring %p\n", script_elem);
+            entry->script = script_elem;   /* takes the reference */
+            list_add_tail(&window->defer_queue, &entry->entry);
+            if(nsparser)
+                nsIParser_Release(nsparser);
+            return NS_OK;
+        }
+    }
