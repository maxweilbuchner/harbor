+/* HARBOR HACK: see run_insert_script() */
+static BOOL is_deferred_script(HTMLScriptElement *script_elem)
+{
+    const PRUnichar *src;
+    cpp_bool defer = FALSE;
+    nsAString src_str;
+    BOOL ret = FALSE;
+
+    if(NS_FAILED(nsIDOMHTMLScriptElement_GetDefer(script_elem->nsscript, &defer)) || !defer)
+        return FALSE;
+
+    nsAString_Init(&src_str, NULL);
+    if(NS_SUCCEEDED(nsIDOMHTMLScriptElement_GetSrc(script_elem->nsscript, &src_str))) {
+        nsAString_GetData(&src_str, &src);
+        ret = *src != 0;
+    }
+    nsAString_Finish(&src_str);
+    return ret;
 }
 
 static nsresult run_insert_script(HTMLDocumentNode *doc, nsISupports *script_iface, nsISupports *parser_iface)
