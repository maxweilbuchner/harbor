+    /* HARBOR HACK - START: a fullscreen program gets a macOS fullscreen Space of its own.
+     *
+     * Wine shows a window that covers the screen by raising it above the menu bar and the Dock on whatever Desktop
+     * it is on, and only while its process is active. A Mac user expects fullscreen to be a Space: a Desktop of its
+     * own in Mission Control, to swipe to and away from, with nothing else on it. So when a program makes a
+     * top-level window cover the screen, the window enters macOS fullscreen; when the program makes it smaller
+     * again, it leaves. If the user takes it out of fullscreen (green button, Ctrl-Cmd-F), it stays out until the
+     * program next changes its size, and Wine's raised window is used as before. The same fallback applies if
+     * macOS refuses the transition. "FullscreenInOwnSpace"=n (Mac Driver registry key) turns this off. */
+    - (void) useOwnSpaceIfFullscreen
+    {
+        BOOL native, covers;
+
+        if (!fullscreen_in_own_space || enteringFullScreen || exitingFullScreen)
+            return;
+
+        native = ([self styleMask] & NSWindowStyleMaskFullScreen) != 0;
+        covers = screen_covered_by_rect([self contentRectForFrameRect:self.wine_fractionalFrame], [NSScreen screens]) != nil;
+
+        if (!covers)
+        {
+            if (native && self.ownSpaceForFullscreen)
+            {
+                /* The Space's own size is smaller than the screen on Macs with a camera housing, and the program
+                 * has been told that size: that isn't leaving fullscreen. */
+                if (NSIsEmptyRect(self.ownSpaceFrame) ||
+                    NSEqualSizes(self.wine_fractionalFrame.size, self.ownSpaceFrame.size))
+                    return;
+                /* The program left fullscreen: leave the Space and take the size it asked for. */
+                self.ownSpaceForFullscreen = FALSE;
+                nonFullscreenFrame = self.wine_fractionalFrame;
+                [super toggleFullScreen:nil];
+            }
+            else if (!native)
+                self.ownSpaceDeclined = FALSE;
+            return;
         }
+
+        if (native || self.ownSpaceForFullscreen || self.ownSpaceDeclined)
+            return;
+        if (![self isVisible] || [self isMiniaturized] || self.parentWindow || self.latentParentWindow)
+            return;
+
+        self.ownSpaceForFullscreen = TRUE;
+        self.ownSpaceFrame = NSZeroRect;
+        [self adjustFullScreenBehavior:[self collectionBehavior]];
+        [self updateFullscreen]; /* no longer Wine's raised kind of fullscreen */
+        [super toggleFullScreen:nil];
     }
+    /* HARBOR HACK - END */
 
