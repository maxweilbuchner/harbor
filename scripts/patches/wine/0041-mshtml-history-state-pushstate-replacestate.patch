+/* HARBOR HACK: history.state, pushState() and replaceState(), which single-page applications use to give
+ * their screens addresses. The state is kept and the window's address changes (location reads it); there is
+ * one entry only, so pushState() replaces too, back() and forward() stay where they are and no popstate event
+ * is sent. Gecko isn't told: what it resolves relative addresses against stays the address the page came from. */
+static inline OmHistory *impl_from_IWineMSHTMLHistory(IWineMSHTMLHistory *iface)
+{
+    return CONTAINING_RECORD(iface, OmHistory, IWineMSHTMLHistory_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(OmHistoryPrivate, IWineMSHTMLHistory, impl_from_IWineMSHTMLHistory(iface)->dispex)
+
+static HRESULT WINAPI OmHistoryPrivate_get_state(IWineMSHTMLHistory *iface, VARIANT *p)
+{
+    OmHistory *This = impl_from_IWineMSHTMLHistory(iface);
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    V_VT(p) = VT_EMPTY;
+    if(V_VT(&This->state) == VT_EMPTY) {
+        V_VT(p) = VT_NULL;
+        return S_OK;
+    }
+    return VariantCopy(p, &This->state);
+}
+
+static HRESULT history_set_state(OmHistory *This, VARIANT *data, VARIANT *url)
+{
+    HTMLOuterWindow *window = This->window ? This->window->base.outer_window : NULL;
+    VARIANT state;
+    HRESULT hres;
+
+    if(!window)
+        return E_UNEXPECTED;
+
+    if(url && V_VT(url) == (VT_BYREF|VT_VARIANT))
+        url = V_VARIANTREF(url);
+    if(url && V_VT(url) == VT_BSTR && V_BSTR(url)) {
+        BSTR old_scheme = NULL, new_scheme = NULL, old_host = NULL, new_host = NULL;
+        DWORD old_port = 0, new_port = 0;
+        BOOL same_origin;
+        IUri *uri;
+
+        if(!window->uri)
+            return E_UNEXPECTED;
+        hres = CoInternetCombineUrlEx(window->uri, V_BSTR(url), URL_ESCAPE_SPACES_ONLY|URL_DONT_ESCAPE_EXTRA_INFO, &uri, 0);
+        if(FAILED(hres))
+            return hres;
+
+        /* a page may only name addresses of its own origin */
+        IUri_GetSchemeName(window->uri, &old_scheme);
+        IUri_GetSchemeName(uri, &new_scheme);
+        IUri_GetHost(window->uri, &old_host);
+        IUri_GetHost(uri, &new_host);
+        IUri_GetPort(window->uri, &old_port);
+        IUri_GetPort(uri, &new_port);
+        same_origin = old_scheme && new_scheme && !wcsicmp(old_scheme, new_scheme)
+            && old_host && new_host && !wcsicmp(old_host, new_host) && old_port == new_port;
+        SysFreeString(old_scheme);
+        SysFreeString(new_scheme);
+        SysFreeString(old_host);
+        SysFreeString(new_host);
+        if(!same_origin) {
+            WARN("%s is not of the document's origin\n", debugstr_w(V_BSTR(url)));
+            IUri_Release(uri);
+            return E_ACCESSDENIED;
+        }
+
+        set_current_uri(window, uri);
+        IUri_Release(uri);
+    }
+
+    V_VT(&state) = VT_EMPTY;
+    if(data) {
+        hres = VariantCopyInd(&state, data);
+        if(FAILED(hres))
+            return hres;
+    }
+    VariantClear(&This->state);
+    This->state = state;
+    return S_OK;
+}
+
+static HRESULT WINAPI OmHistoryPrivate_pushState(IWineMSHTMLHistory *iface, VARIANT *data, VARIANT *title, VARIANT *url)
+{
+    OmHistory *This = impl_from_IWineMSHTMLHistory(iface);
+
+    TRACE("(%p)->(%s %s %s)\n", This, debugstr_variant(data), debugstr_variant(title), debugstr_variant(url));
+
+    return history_set_state(This, data, url);
+}
+
+static HRESULT WINAPI OmHistoryPrivate_replaceState(IWineMSHTMLHistory *iface, VARIANT *data, VARIANT *title, VARIANT *url)
+{
+    OmHistory *This = impl_from_IWineMSHTMLHistory(iface);
+
+    TRACE("(%p)->(%s %s %s)\n", This, debugstr_variant(data), debugstr_variant(title), debugstr_variant(url));
+
+    return history_set_state(This, data, url);
+}
+
+static const IWineMSHTMLHistoryVtbl OmHistoryPrivateVtbl = {
+    OmHistoryPrivate_QueryInterface,
+    OmHistoryPrivate_AddRef,
+    OmHistoryPrivate_Release,
+    OmHistoryPrivate_GetTypeInfoCount,
+    OmHistoryPrivate_GetTypeInfo,
+    OmHistoryPrivate_GetIDsOfNames,
+    OmHistoryPrivate_Invoke,
+    OmHistoryPrivate_get_state,
+    OmHistoryPrivate_pushState,
+    OmHistoryPrivate_replaceState
 };
 
