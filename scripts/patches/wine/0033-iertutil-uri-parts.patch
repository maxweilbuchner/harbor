+/* urlmon does the parsing. It is loaded when a URI is first asked for one of its parts, so that iertutil
+ * doesn't pull urlmon and oleaut32 into every process that loads it. */
+static HRESULT (WINAPI *p_CreateUri)(const WCHAR *, DWORD, DWORD_PTR, IUri **);
+static void (WINAPI *p_SysFreeString)(BSTR);
+static UINT (WINAPI *p_SysStringLen)(BSTR);
+
+static IUri *uri_get_parsed(struct uri *impl)
+{
+    IUri *parsed;
+
+    if (impl->parsed) return impl->parsed;
+    if (!p_CreateUri)
+    {
+        HMODULE urlmon = LoadLibraryW(L"urlmon.dll"), oleaut32 = LoadLibraryW(L"oleaut32.dll");
+
+        if (!urlmon || !oleaut32) return NULL;
+        p_SysFreeString = (void *)GetProcAddress(oleaut32, "SysFreeString");
+        p_SysStringLen = (void *)GetProcAddress(oleaut32, "SysStringLen");
+        p_CreateUri = (void *)GetProcAddress(urlmon, "CreateUri");
+        if (!p_CreateUri || !p_SysFreeString || !p_SysStringLen) return NULL;
+    }
+    if (FAILED(p_CreateUri(WindowsGetStringRawBuffer(impl->raw_uri, NULL), Uri_CREATE_ALLOW_RELATIVE, 0, &parsed)))
+        return NULL;
+    if (InterlockedCompareExchangePointer((void **)&impl->parsed, parsed, NULL))
+        IUri_Release(parsed);
+    return impl->parsed;
+}
+
+static HRESULT uri_get_part(IUriRuntimeClass *iface, Uri_PROPERTY part, HSTRING *value)
+{
+    struct uri *impl = CONTAINING_RECORD(iface, struct uri, IUriRuntimeClass_iface);
+    IUri *parsed;
+    HRESULT hr;
+    BSTR str;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(parsed = uri_get_parsed(impl))) return E_FAIL;
+    /* A part the URI doesn't have is the empty string, as on Windows. */
+    if (FAILED(hr = IUri_GetPropertyBSTR(parsed, part, &str, 0))) return hr;
+    hr = WindowsCreateString(str, p_SysStringLen(str), value);
+    p_SysFreeString(str);
+    return hr;
+}
+
 static inline struct uri *impl_from_IUriRuntimeClass(IUriRuntimeClass *iface)
 {
     return CONTAINING_RECORD(iface, struct uri, IUriRuntimeClass_iface);
